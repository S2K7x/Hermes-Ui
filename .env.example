# Hermes API server. Keep it on loopback — the API executes the full toolset
# (terminal included) on this host, so 8642 must never leave 127.0.0.1.
HERMES_API_URL=http://127.0.0.1:8642

# Must match API_SERVER_KEY in ~/.hermes/.env. Root-equivalent secret: it stays
# server-side in the SvelteKit proxy and is never sent to the browser.
HERMES_API_KEY=

# Stable long-term-memory scope (X-Hermes-Session-Key). Must NOT change between
# conversations, or Honcho/FTS5 memory fragments per session_id.
HERMES_SESSION_KEY=agent:main:webui:dm:user

# Hermes' own dashboard (hermes_cli/web_server.py), a SECOND loopback server,
# running here as the `hermes-dashboard` user service. The Providers panel
# proxies it to read and write provider credentials — writing ~/.hermes/.env
# ourselves would miss the copies config.yaml keeps of the same key.
HERMES_DASHBOARD_URL=http://127.0.0.1:9119

# Its session token, sent as X-Hermes-Session-Token. Copy the value of
# HERMES_DASHBOARD_SESSION_TOKEN from ~/.hermes/dashboard.env (the systemd unit
# reads that file, so the token survives restarts). Optional: leave it empty
# and the Providers panel disables itself, like the skills editor without its
# bind mount. Never sent to the browser.
HERMES_DASHBOARD_TOKEN=

# UI-only SQLite (prefs + title cache). Put it on the SSD, never the SD card.
WEB_DB_PATH=./data/hermes-web.db

# Public origin served by Tailscale Serve. Required: the runtime origin check
# in src/hooks.server.ts rejects browser POSTs from anywhere else.
HERMES_PUBLIC_ORIGIN=https://your-machine.your-tailnet.ts.net

# Read by adapter-node itself. Keep it equal to HERMES_PUBLIC_ORIGIN — without
# it the server rebuilds the origin as http:// from the Host header and no
# browser request through Serve will ever match. docker-compose sets it for you.
ORIGIN=https://your-machine.your-tailnet.ts.net

# Node server bind. Loopback only: Tailscale Serve is what publishes it.
HOST=127.0.0.1
PORT=3000

# Timeout for non-streaming Hermes calls. Agent streams ignore it.
HERMES_TIMEOUT_MS=30000

# Local cap on simultaneous agent turns, refused before Hermes' own cap of 10.
# A Pi 5 struggles well before ten agents each spawn a browser.
MAX_CONCURRENT_TURNS=3

# Hard ceiling on one turn (ms). The server follows a turn to its end even
# after the browser leaves, so this is what frees a wedged run's slot.
MAX_TURN_MS=1200000

# Web Push (RFC 8292 VAPID). Generate a P-256 pair once:
#   node -e "const {createECDH}=require('node:crypto');const k=createECDH('prime256v1');k.generateKeys();console.log('VAPID_PUBLIC_KEY='+k.getPublicKey().toString('base64url'));console.log('VAPID_PRIVATE_KEY='+k.getPrivateKey().toString('base64url'))"
# The public key IS sent to the browser — that is its job (applicationServerKey
# in pushManager.subscribe). The private key signs the requests to the push
# service and stays here, like HERMES_API_KEY. Leave all three empty and the
# notifications section of the status panel disables itself.
# Rotating the keys invalidates every existing subscription: each device has to
# be re-enabled from the panel.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact the push service can reach if it needs to complain.
VAPID_SUBJECT=mailto:you@example.com

# Hermes' skill tree on the HOST, bind-mounted read-write into the container at
# /skills. Only used by docker-compose.yml; the app itself reads SKILLS_DIR.
HERMES_SKILLS_DIR=/home/pi/.hermes/skills

# Path of that tree as the SERVER sees it. docker-compose sets it to /skills.
# Outside Docker (npm run dev) point it at the host path to enable the skills
# editor; leave it unset and the editor disables itself cleanly.
# SKILLS_DIR=/home/pi/.hermes/skills
